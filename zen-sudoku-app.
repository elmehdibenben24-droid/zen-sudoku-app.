<!DOCTYPE html>
<html lang="en" dir="ltr" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zen Sudoku</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom Themes */
        .theme-midnight { --bg: #0f172a; --text: #f8fafc; --cell-bg: #1e293b; --cell-border: #334155; --accent: #10b981; --error: #f59e0b; }
        .theme-matcha { --bg: #f2f7f4; --text: #1f2937; --cell-bg: #ffffff; --cell-border: #d1d5db; --accent: #059669; --error: #d97706; }
        .theme-sand { --bg: #fdfbf7; --text: #43302b; --cell-bg: #ffffff; --cell-border: #e7e5e4; --accent: #b45309; --error: #ea580c; }
        
        body { background-color: var(--bg); color: var(--text); transition: all 0.3s ease; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        
        .sudoku-grid { display: grid; grid-template-columns: repeat(9, 1fr); gap: 1px; background-color: var(--cell-border); border: 2px solid var(--text); width: 100%; max-width: 400px; margin: 0 auto; }
        .cell { aspect-ratio: 1; background-color: var(--cell-bg); display: flex; align-items: center; justify-content: center; font-size: 1.25rem; cursor: pointer; transition: background-color 0.2s; user-select: none; }
        .cell.fixed { font-weight: bold; color: var(--text); }
        .cell.editable { color: var(--accent); }
        .cell.selected { background-color: var(--accent); color: white; }
        .cell.calm-error { animation: softPulse 1.5s ease; }
        
        /* 3x3 Block Borders */
        .cell:nth-child(3n) { border-right: 2px solid var(--text); }
        .cell:nth-child(9n) { border-right: none; }
        .cell:nth-child(n+19):nth-child(-n+27), .cell:nth-child(n+46):nth-child(-n+54) { border-bottom: 2px solid var(--text); }

        @keyframes softPulse { 0% { background-color: var(--cell-bg); } 50% { background-color: var(--error); color: white; } 100% { background-color: var(--cell-bg); } }
    </style>
</head>
<body class="theme-midnight min-h-screen flex flex-col items-center py-8 px-4">

    <!-- Header & Controls -->
    <div class="w-full max-w-md flex justify-between items-center mb-6">
        <h1 class="text-3xl font-light tracking-widest" id="app-title">ZEN</h1>
        <div class="flex gap-2">
            <!-- Theme Selector -->
            <button onclick="setTheme('theme-midnight')" class="w-6 h-6 rounded-full bg-slate-900 border border-gray-400"></button>
            <button onclick="setTheme('theme-matcha')" class="w-6 h-6 rounded-full bg-[#f2f7f4] border border-gray-400"></button>
            <button onclick="setTheme('theme-sand')" class="w-6 h-6 rounded-full bg-[#fdfbf7] border border-gray-400"></button>
        </div>
    </div>

    <!-- Status Bar -->
    <div class="w-full max-w-md flex justify-between items-center mb-6 text-sm opacity-80">
        <div class="flex items-center gap-2">
            <span id="streak-label">Mindful Streak:</span>
            <span id="streak-count" class="font-bold text-lg" style="color: var(--accent)">0</span> 🔥
        </div>
        <button onclick="toggleAudio()" id="audio-btn" class="flex items-center gap-2 hover:opacity-100 transition">
            <span id="audio-label">Sound Off</span> 🎵
        </button>
    </div>

    <!-- Difficulty & Lang -->
    <div class="w-full max-w-md flex justify-between items-center mb-4">
        <select id="difficulty" onchange="startNewGame()" class="bg-transparent border border-current rounded px-2 py-1 outline-none text-sm">
            <option value="40" class="text-black" id="diff-breeze">Breeze</option>
            <option value="50" class="text-black" id="diff-flow">Flow</option>
            <option value="60" class="text-black" id="diff-deep">Deep Focus</option>
        </select>
        <select id="language" onchange="setLanguage(this.value)" class="bg-transparent border border-current rounded px-2 py-1 outline-none text-sm">
            <option value="en" class="text-black">EN</option>
            <option value="fr" class="text-black">FR</option>
            <option value="ar" class="text-black">AR</option>
        </select>
    </div>

    <!-- Game Board -->
    <div id="sudoku-board" class="sudoku-grid mb-6 rounded-sm overflow-hidden shadow-2xl"></div>

    <!-- Numpad -->
    <div class="grid grid-cols-5 gap-2 w-full max-w-md mb-8">
        <script>
            for(let i=1; i<=9; i++) {
                document.write(`<button onclick="inputNumber(${i})" class="py-3 rounded text-xl font-medium" style="background-color: var(--cell-border)">${i}</button>`);
            }
        </script>
        <button onclick="inputNumber(0)" class="py-3 rounded text-sm font-medium" style="background-color: var(--cell-border)" id="btn-erase">Erase</button>
    </div>

    <!-- Win Modal (Mindful Reward) -->
    <div id="win-modal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center p-4 z-50 transition-opacity">
        <div class="text-center p-8 rounded-2xl max-w-sm w-full" style="background-color: var(--bg); color: var(--text)">
            <h2 class="text-2xl mb-4 font-light" id="win-title">Inner Peace Achieved</h2>
            <p class="text-lg mb-8 italic opacity-80" id="win-quote">"Quiet the mind, and the soul will speak."</p>
            <button onclick="startNewGame(); document.getElementById('win-modal').classList.add('hidden')" class="px-6 py-2 rounded-full font-medium" style="background-color: var(--accent); color: white" id="btn-new">Flow Again</button>
        </div>
    </div>

    <!-- Audio Element (Nature Sound) -->
    <audio id="zen-audio" loop src="https://cdn.pixabay.com/download/audio/2021/08/09/audio_88447e1286.mp3?filename=soft-rain-ambient-111154.mp3"></audio>

    <script>
        /* --- Translations --- */
        const dict = {
            en: { title: "ZEN", streak: "Mindful Streak:", sndOff: "Sound Off", sndOn: "Sound On", breeze: "Breeze", flow: "Flow", deep: "Deep Focus", erase: "Erase", winTitle: "Inner Peace Achieved", newGame: "Flow Again" },
            fr: { title: "ZEN", streak: "Série Zen:", sndOff: "Son Désactivé", sndOn: "Son Activé", breeze: "Brise", flow: "Fluidité", deep: "Concentration", erase: "Effacer", winTitle: "Paix Intérieure", newGame: "Rejouer" },
            ar: { title: "هدوء", streak: "أيام التأمل:", sndOff: "الصوت مغلق", sndOn: "الصوت شغال", breeze: "نسيم", flow: "تدفق", deep: "تركيز عميق", erase: "مسح", winTitle: "اكتمل اللغز بسلام", newGame: "العب مجدداً" }
        };

        /* --- Global State --- */
        let selectedCell = null;
        let solution = [];
        let puzzle = [];
        let currentLang = 'en';
        let isAudioPlaying = false;

        /* --- Initialize --- */
        document.addEventListener('DOMContentLoaded', () => {
            // Load streak
            let streak = localStorage.getItem('zenStreak') || 0;
            document.getElementById('streak-count').innerText = streak;
            startNewGame();
        });

        /* --- UI Functions --- */
        function setTheme(themeName) {
            document.body.className = `${themeName} min-h-screen flex flex-col items-center py-8 px-4`;
        }

        function setLanguage(lang) {
            currentLang = lang;
            document.getElementById('html-root').dir = lang === 'ar' ? 'rtl' : 'ltr';
            document.getElementById('app-title').innerText = dict[lang].title;
            document.getElementById('streak-label').innerText = dict[lang].streak;
            document.getElementById('audio-label').innerText = isAudioPlaying ? dict[lang].sndOn : dict[lang].sndOff;
            document.getElementById('diff-breeze').innerText = dict[lang].breeze;
            document.getElementById('diff-flow').innerText = dict[lang].flow;
            document.getElementById('diff-deep').innerText = dict[lang].deep;
            document.getElementById('btn-erase').innerText = dict[lang].erase;
            document.getElementById('win-title').innerText = dict[lang].winTitle;
            document.getElementById('btn-new').innerText = dict[lang].newGame;
        }

        function toggleAudio() {
            const audio = document.getElementById('zen-audio');
            if(isAudioPlaying) { audio.pause(); isAudioPlaying = false; }
            else { audio.play(); isAudioPlaying = true; }
            document.getElementById('audio-label').innerText = isAudioPlaying ? dict[currentLang].sndOn : dict[currentLang].sndOff;
        }

        /* --- Sudoku Logic (Simplified Generator for Web MVP) --- */
        function generateBaseGrid() {
            // A valid completed sudoku grid shifted for simplicity in this MVP
            return [
                [4,3,5,2,6,9,7,8,1], [6,8,2,5,7,1,4,9,3], [1,9,7,8,3,4,5,6,2],
                [8,2,6,1,9,5,3,4,7], [3,7,4,6,8,2,9,1,5], [9,5,1,7,4,3,6,2,8],
                [5,1,9,3,2,6,8,7,4], [2,4,8,9,5,7,1,3,6], [7,6,3,4,1,8,2,5,9]
            ];
        }

        function startNewGame() {
            let base = generateBaseGrid();
            // Randomly shuffle rows within blocks to make it feel new
            solution = base.flat();
            puzzle = [...solution];
            
            // Remove numbers based on difficulty
            let cellsToRemove = parseInt(document.getElementById('difficulty').value);
            while(cellsToRemove > 0) {
                let idx = Math.floor(Math.random() * 81);
                if(puzzle[idx] !== 0) {
                    puzzle[idx] = 0;
                    cellsToRemove--;
                }
            }
            renderBoard();
        }

        function renderBoard() {
            const boardEl = document.getElementById('sudoku-board');
            boardEl.innerHTML = '';
            for(let i=0; i<81; i++) {
                let cell = document.createElement('div');
                cell.className = 'cell ' + (puzzle[i] === 0 ? 'editable' : 'fixed');
                cell.innerText = puzzle[i] === 0 ? '' : puzzle[i];
                cell.onclick = () => selectCell(i, cell);
                boardEl.appendChild(cell);
            }
        }

        function selectCell(index, el) {
            if(puzzle[index] !== 0) return; // Can't edit fixed cells
            document.querySelectorAll('.cell').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
            selectedCell = { index, el };
        }

        function inputNumber(num) {
            if(!selectedCell) return;
            
            if(num === 0) {
                selectedCell.el.innerText = '';
                return;
            }

            // Calm Validation
            if(num === solution[selectedCell.index]) {
                selectedCell.el.innerText = num;
                selectedCell.el.classList.remove('selected');
                selectedCell = null;
                checkWin();
            } else {
                // Calm Error: pulse softly, don't write the wrong number
                selectedCell.el.classList.remove('calm-error');
                void selectedCell.el.offsetWidth; // trigger reflow
                selectedCell.el.classList.add('calm-error');
            }
        }

        function checkWin() {
            let cells = document.querySelectorAll('.cell');
            let isComplete = Array.from(cells).every((c, idx) => c.innerText == solution[idx]);
            if(isComplete) {
                // Update Streak
                let streak = parseInt(localStorage.getItem('zenStreak') || 0) + 1;
                localStorage.setItem('zenStreak', streak);
                document.getElementById('streak-count').innerText = streak;
                // Show Reward
                document.getElementById('win-modal').classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
